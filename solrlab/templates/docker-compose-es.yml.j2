# Generated by solrlab — do not edit by hand (regenerate with `solrlab up`)
name: {{ project_name }}

services:
{% set prefix = "es" if engine == "elasticsearch" else "os" %}
{% set image = "docker.elastic.co/elasticsearch/elasticsearch:" + solr_version
   if engine == "elasticsearch" else "opensearchproject/opensearch:" + solr_version %}
{% for i in range(solr_nodes) %}
  {{ prefix }}{{ i + 1 }}:
    image: {{ image }}
    container_name: {{ project_name }}-{{ prefix }}{{ i + 1 }}
    restart: unless-stopped
    ports:
      - "{{ base_port + i }}:9200"
    environment:
      node.name: {{ prefix }}{{ i + 1 }}
      cluster.name: {{ project_name }}
{% if solr_nodes == 1 %}
      discovery.type: single-node
{% else %}
      discovery.seed_hosts: {% for j in range(solr_nodes) %}{{ prefix }}{{ j + 1 }}{% if not loop.last %},{% endif %}{% endfor %}

      cluster.initial_master_nodes: {% for j in range(solr_nodes) %}{{ prefix }}{{ j + 1 }}{% if not loop.last %},{% endif %}{% endfor %}

{% endif %}
{% if engine == "elasticsearch" %}
      xpack.security.enabled: "false"
      ES_JAVA_OPTS: "-Xms{{ heap }} -Xmx{{ heap }}{% if gc_tune %} {{ gc_tune }}{% endif %}"
{% else %}
      DISABLE_SECURITY_PLUGIN: "true"
      DISABLE_INSTALL_DEMO_CONFIG: "true"
      OPENSEARCH_JAVA_OPTS: "-Xms{{ heap }} -Xmx{{ heap }}{% if gc_tune %} {{ gc_tune }}{% endif %}"
{% endif %}
{% if gc_logs %}
    volumes:
      - ./gc-logs/{{ prefix }}{{ i + 1 }}:/usr/share/{{ engine }}/logs
{% endif %}
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    networks: [solrlab]
{% endfor %}

networks:
  solrlab:
    name: {{ project_name }}
