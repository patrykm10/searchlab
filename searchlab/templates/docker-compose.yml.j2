# Generated by searchlab — do not edit by hand (regenerate with `searchlab up`)
name: {{ project_name }}

services:
{% for i in range(zk_nodes) %}
  zk{{ i + 1 }}:
    image: zookeeper:{{ zk_version }}
    container_name: {{ project_name }}-zk{{ i + 1 }}
    restart: unless-stopped
    environment:
      ZOO_MY_ID: {{ i + 1 }}
      ZOO_SERVERS: {% for j in range(zk_nodes) %}server.{{ j + 1 }}={% if j == i %}0.0.0.0{% else %}zk{{ j + 1 }}{% endif %}:2888:3888;2181 {% endfor %}

      ZOO_4LW_COMMANDS_WHITELIST: mntr,conf,ruok,stat
    networks: [searchlab]
{% endfor %}

{% for i in range(solr_nodes) %}
  solr{{ i + 1 }}:
    image: solr:{{ solr_version }}
    container_name: {{ project_name }}-solr{{ i + 1 }}
    restart: unless-stopped
    depends_on:
{% for j in range(zk_nodes) %}
      - zk{{ j + 1 }}
{% endfor %}
    ports:
      - "{{ base_port + i }}:8983"
    environment:
      ZK_HOST: {% for j in range(zk_nodes) %}zk{{ j + 1 }}:2181{% if not loop.last %},{% endif %}{% endfor %}

      SOLR_HEAP: "{{ heap }}"
{% if gc_tune %}
      GC_TUNE: "{{ gc_tune }}"
{% endif %}
{% if solr_opts %}
      SOLR_OPTS: "{{ solr_opts }}"
{% endif %}
      SOLR_HOST: solr{{ i + 1 }}
{% if gc_logs %}
    volumes:
      - ./gc-logs/solr{{ i + 1 }}:/var/solr/logs
{% endif %}
    networks: [searchlab]
{% endfor %}

{% if monitoring %}
  solr-exporter:
    image: solr:{{ solr_version }}
    container_name: {{ project_name }}-exporter
    restart: unless-stopped
    depends_on:
      - solr1
    entrypoint:
      - /opt/solr/contrib/prometheus-exporter/bin/solr-exporter
      - -p
      - "9854"
      - -z
      - {% for j in range(zk_nodes) %}zk{{ j + 1 }}:2181{% if not loop.last %},{% endif %}{% endfor %}

      - -f
      - /opt/solr/contrib/prometheus-exporter/conf/solr-exporter-config.xml
    ports:
      - "9854:9854"
    networks: [searchlab]

  prometheus:
    image: prom/prometheus:latest
    container_name: {{ project_name }}-prometheus
    restart: unless-stopped
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
    ports:
      - "9090:9090"
    networks: [searchlab]

  grafana:
    image: grafana/grafana:latest
    container_name: {{ project_name }}-grafana
    restart: unless-stopped
    environment:
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Admin
    ports:
      - "3000:3000"
    networks: [searchlab]
{% endif %}

networks:
  searchlab:
    name: {{ project_name }}
